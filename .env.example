# Lazer Lending CRM env vars — placeholders only. Copy to .env and fill in via /load-creds (1Password) or directly.

# --- Connect CRM scaffold (inherited) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# APOLLO_API_KEY removed for Lazer — lead sourcing is via CSV upload, not Apollo's database.
# (apollo-search Edge Function still deployed for its inherited ZeroBounce code path,
#  but the lead-search side will 401 silently without a key — that's expected.)
# Set VITE_APOLLO_AVAILABLE=true to unhide the Lead Generator UI on non-Lazer deployments.
VITE_APOLLO_AVAILABLE=
# Server-side only — set via `supabase secrets set`, NOT used by Vite
OPENROUTER_API_KEY=your_openrouter_api_key

# --- Vendor: Smartlead ---
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SIGNING_SECRET=
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1

# --- Vendor: Mailforge ---
MAILFORGE_API_KEY=
MAILFORGE_BASE_URL=
MAILFORGE_DEFAULT_BUNDLE=

# --- Vendor: ZeroBounce ---
ZEROBOUNCE_API_KEY=your_zerobounce_api_key

# ---------------------------------------------------------------------------
# Lazer Lending CRM — added Phase 1 (2026-05-05)
# Set via: supabase secrets set KEY=value --project-ref <ref>
# ---------------------------------------------------------------------------

# Smartlead cold-sending engine
SMARTLEAD_API_KEY=your_smartlead_api_key
SMARTLEAD_BASE_URL=https://server.smartlead.ai
SMARTLEAD_WEBHOOK_SIGNING_SECRET=your_smartlead_webhook_signing_secret

# Resend transactional domain (NEVER used for cold sends)
RESEND_TRANSACTIONAL_DOMAIN=notify.lazerlending.com
# Override for non-Lazer deployments; defaults to mail.<RESEND_TRANSACTIONAL_DOMAIN>
RESEND_CAMPAIGN_DOMAIN=

# List-Unsubscribe HMAC token secret (stateless; rotate with care — see PLAN.md §1.10)
LIST_UNSUB_TOKEN_SECRET=generate_with_openssl_rand_hex_32
# Token TTL in days (default 1825 = 5 years)
LIST_UNSUB_TOKEN_TTL_DAYS=1825

# Follow Up Boss push
FUB_API_KEY=your_fub_api_key
FUB_X_SYSTEM_KEY=your_fub_x_system_key
FUB_DEFAULT_SOURCE_LABEL=Cold Email CRM
FUB_DEFAULT_STAGE_NAME=Cold Lead

# Team notification email for reply routing (per-campaign override via campaigns.team_email)
DEFAULT_REPLY_FORWARD_EMAIL=team@lazerlending.com

# LLM classifier — single OpenRouter key drives every AI feature in this app.
# OpenRouter routes to Anthropic with a no-train DPA on commercial accounts.
CLASSIFIER_PROVIDER=openrouter
CLASSIFIER_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_API_KEY is set above (Connect CRM scaffold) and re-used here.

# Site URL (used in unsubscribe links)
SITE_URL=https://crm.lazerlending.com

# Team domain — drives {emailPrefix}@<domain> rendering in Settings + Outreach Compose.
# For Lazer: lazerlending.com. For Connect CRM: integrateapi.ai. Falls back to
# integrateapi.ai if unset (preserves Connect CRM behavior).
VITE_TEAM_DOMAIN=lazerlending.com

# DMARC RUA aggregator
DMARC_RUA_PROVIDER=cloudflare
